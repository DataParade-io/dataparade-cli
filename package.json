{
  "name": "@dataparade/cli",
  "version": "0.0.13",
  "description": "dataPARADE CLI — scan codebases for privacy and security data flows",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "GPL-3.0-or-later",
  "author": "DataParade",
  "homepage": "https://dataparade.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DataParade-io/dataparade-cli.git"
  },
  "bugs": {
    "url": "https://github.com/DataParade-io/dataparade-cli/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dataparade",
    "privacy",
    "data-flow",
    "security",
    "cli",
    "scanner"
  ],
  "private": false,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./ai-providers": {
      "types": "./dist/src/ai-enrichment/providers/index.d.ts",
      "default": "./dist/src/ai-enrichment/providers/index.js"
    }
  },
  "bin": {
    "@dataparade/cli": "dist/bin/cli.js"
  },
  "scripts": {
    "ensure-scanner": "node scripts/ensure-scanner-built.mjs",
    "build": "pnpm exec tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run ensure-scanner && pnpm run build && pnpm run test",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "pretest": "pnpm run ensure-scanner && pnpm run build",
    "test": "jest",
    "eval:interview-a0": "jest tests/eval/interview-a0/eval.spec.ts",
    "eval:interview-a0:datap-673": "jest tests/eval/interview-a0/experiments/datap-673/score-model-run.spec.ts",
    "eval:interview-a0:datap-674": "jest tests/eval/interview-a0/experiments/datap-674/score-model-run.spec.ts",
    "eval:interview-a0:datap-676": "jest tests/eval/interview-a0/experiments/datap-676/score-model-run.spec.ts",
    "eval:interview-a0:datap-691": "jest tests/eval/interview-a0/experiments/datap-691/score-model-run.spec.ts --watchman=false",
    "eval:interview-a0:datap-693": "jest tests/eval/interview-a0/experiments/datap-693/score-model-run.spec.ts --watchman=false",
    "eval:interview-a0:run-model-luna-676": "node tests/eval/interview-a0/experiments/datap-676/run-model-interview.mjs",
    "eval:interview-a0:run-model-luna-691": "node tests/eval/interview-a0/experiments/datap-691/run-model-interview.mjs",
    "eval:interview-a0:run-model-luna-693": "node tests/eval/interview-a0/experiments/datap-693/run-model-interview.mjs",
    "export-bundle-to-land-candidate": "node tests/eval/interview-a0/bin/export-bundle-to-land-candidate.mjs",
    "land-ocsf-discovery": "node tests/eval/interview-a0/bin/land-ocsf-discovery.mjs",
    "validate-ocsf-discovery": "node tests/eval/interview-a0/bin/validate-ocsf-discovery.mjs",
    "eval:interview-a0:run-model": "node tests/eval/interview-a0/experiments/datap-673/run-model-interview.mjs",
    "eval:interview-a0:run-model-luna": "node tests/eval/interview-a0/experiments/datap-674/run-model-interview.mjs",
    "scan": "node dist/bin/cli.js scan",
    "eval:models": "pnpm exec node dist/src/evals/run-model-matrix.js"
  },
  "dependencies": {
    "@dataparade/scanner": "github:DataParade-io/scanner#998fb12b2db667dd7ff305e34c716634b867e806",
    "@sentry/node": "^10.38.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "langsmith": "^0.3.14",
    "typescript": "^5.7.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript-eslint": "^8.20.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ]
}
