# Workspace platform AI + quota (Workspace → Access keys in the app).
# Quota preflight/complete runs only when BOTH are set:
# DATAPARADE_WORKSPACE_API_KEY=dp_live_...
# SCAN_AI_INFERENCE=true
# Structural-only scans (no SCAN_AI_INFERENCE) do not call the quota API even if a key is set.

# API origin — omit when using @dataparade/cli from npm (defaults to production AWS API).
# Monorepo / local backend only:
# DATAPARADE_API_BASE_URL=http://localhost:3000

# Optional DATAPARADE_AI_ENDPOINT only if you use Azure or a proxy URL that includes "chat/completions".
DATAPARADE_AI_INFERENCE=true
DATAPARADE_AI_PROVIDER=openai
DATAPARADE_AI_MODEL="gpt-4o-mini"
DATAPARADE_AI_API_KEY=""
# Large responses for filling many properties per node (default OpenAI path floors at 4096).
# DATAPARADE_AI_MAX_TOKENS=12000

# Log provider HTTP errors and why proposals were dropped (parse / normalization).
# SCAN_AI_DEBUG=true

# OpenAI Chat Completions: use Structured Outputs (response_format json_schema from Zod). Default on.
# Set to 0/false for older models that only support json_object mode.
# DATAPARADE_AI_OPENAI_JSON_SCHEMA=0
# Optional: json_schema.strict (stricter shape; Zod optionals may break — use with care).
# DATAPARADE_AI_OPENAI_JSON_SCHEMA_STRICT=true

# Queue every matching node/flow per agent (large scans: slow / huge prompts).
# Default 25 if unset. Use 0 for no cap.
# DATAPARADE_AI_MAX_CANDIDATES_PER_AGENT=0
# Max provider calls per planned queue (tpAgent: effectively caps TP candidates processed).
# DATAPARADE_AI_MAX_CALLS=4
# Estimated token budget per planned queue.
# DATAPARADE_AI_BUDGET_TOKENS=300000
# Max in-flight provider calls for tpAgent.
# DATAPARADE_AI_PROVIDER_CONCURRENCY=4

# Only enrich third-party nodes (one queue item each); skips assets/actors/flows in AI step.
# DATAPARADE_AI_INFERENCE_SCOPE=third_party_only

# Toggle third-party data-flow inference block in metadata.aiInference.thirdPartyDataFlow.
# Set to false to temporarily disable this output while keeping other AI enrichment on.
# DATAPARADE_AI_THIRD_PARTY_DATA_FLOW=true

# tpAgent orchestrator tool loop limits (third-party inference only).
# Max provider rounds per third-party candidate (default 3).
# DATAPARADE_AI_TOOL_LOOP_MAX_ROUNDS=3
# Max distinct files reviewed per third-party candidate (default 48).
# DATAPARADE_AI_TOOL_LOOP_MAX_FILES=48
# Max deterministic search terms per third-party candidate (default 12).
# DATAPARADE_AI_TOOL_LOOP_MAX_SEARCHES=12

# Anthropic Claude (Messages API)
# DATAPARADE_AI_INFERENCE=true
# DATAPARADE_AI_PROVIDER=anthropic
# DATAPARADE_AI_MODEL="claude-sonnet-4-5"
# DATAPARADE_AI_API_KEY=""
# Optional endpoint override (defaults to https://api.anthropic.com/v1/messages)
# DATAPARADE_AI_ENDPOINT="https://api.anthropic.com/v1/messages"

# Gemini (generateContent API)
# DATAPARADE_AI_INFERENCE=true
# DATAPARADE_AI_PROVIDER=gemini
# DATAPARADE_AI_MODEL="gemini-1.5-flash"
# DATAPARADE_AI_API_KEY=""
# Optional base/endpoint override:
# - base form: https://generativelanguage.googleapis.com/v1beta/models
# - full form: https://generativelanguage.googleapis.com/v1beta/models/<model>:generateContent
# DATAPARADE_AI_ENDPOINT="https://generativelanguage.googleapis.com/v1beta/models"

# Local models (Ollama /api/generate)
# DATAPARADE_AI_INFERENCE=true
# DATAPARADE_AI_PROVIDER=local
# DATAPARADE_AI_ENDPOINT="http://localhost:11434/api/generate"
# DATAPARADE_AI_MODEL="llama3.1"

# For LangSmith
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
#LANGSMITH_TRACING=true
LANGSMITH_PROJECT=